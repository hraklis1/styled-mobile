{
  "expo": {
    "name": "Styled",
    "slug": "Styled-mobile",
    "owner": "pixelcraft-apps",
    "scheme": "styled",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ttrypho.Styled-mobile",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Styled needs camera access to photograph your clothing items and add them to your wardrobe.",
        "NSPhotoLibraryUsageDescription": "Styled needs access to your photo library to import clothing images into your wardrobe.",
        "NSSpeechRecognitionUsageDescription": "Styled uses speech recognition to turn your dictation into text.",
        "NSMicrophoneUsageDescription": "Styled needs microphone access so you can dictate to your stylist.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.68027085249-ihvksfh38gm9j1e8qcmbc4vd846q45m9"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.ttrypho.styledmobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Styled needs access to your photos to add clothing items to your wardrobe.",
          "cameraPermission": "Styled needs camera access to photograph your clothing items."
        }
      ],
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Styled needs microphone access so you can dictate to your stylist.",
          "speechRecognitionPermission": "Styled uses speech recognition to turn your dictation into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Styled uses your location to identify the store branch for shopping photos and provide weather-aware outfit suggestions."
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Styled needs camera access to quickly save clothing items and price tags while you shop.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "./plugins/withMinimumPodDeploymentTarget",
        {
          "minimumDeploymentTarget": "15.0"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "71e136d6-599f-486a-8fbb-15f21cc481db"
      }
    }
  }
}
