--- a/node_modules/@posthog/core/dist/posthog-core-stateless.js
+++ b/node_modules/@posthog/core/dist/posthog-core-stateless.js
@@ -68,6 +68,10 @@
             text = await err.text;
         } catch  {}
         console.error(`Error while flushing PostHog: message=${err.message}, response body=${text}`, err);
+    } else if (isPostHogFetchNetworkError(err)) {
+        // Offline analytics must not trigger React Native's error overlay.
